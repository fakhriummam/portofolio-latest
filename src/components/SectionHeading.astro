---
interface Props {
  index: string;
  label: string;
  title: string;
}
const { index, label, title } = Astro.props;
---

<header class="reveal mb-12 grid gap-4 sm:mb-16 md:grid-cols-12">
  <p class="text-xs font-medium uppercase tracking-[0.18em] text-muted md:col-span-3 md:pt-3">
    <span class="text-accent">{index}</span>
    <span class="mx-2 text-line">—</span>{label}
  </p>
  <h2 class="display text-3xl leading-[1.1] sm:text-4xl md:col-span-9 md:text-5xl">
    {title}
  </h2>
</header>
