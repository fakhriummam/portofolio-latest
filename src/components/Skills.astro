---
import SectionHeading from './SectionHeading.astro';
import { skills, tools, learning } from '../data/profile';
---

<section id="skills" class="section">
  <div class="container-x">
    <SectionHeading index="04" label="Skills" title="What I bring to the team." />

    <div class="grid gap-12 md:grid-cols-3 md:gap-10">
      {
        skills.map((g) => (
          <div class="reveal border-t border-ink pt-6">
            <h3 class="font-mono text-[0.95rem] font-medium"><span class="text-accent"># </span>{g.group.toLowerCase()}</h3>
            <ul class="mt-5 space-y-3 text-ink/80">
              {g.items.map((s) => (
                <li class="flex items-start gap-3 border-b border-line pb-3"><span class="mt-[0.2em] font-mono text-[0.75rem] text-accent" aria-hidden="true">[✓]</span><span>{s}</span></li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="mt-16 grid gap-10 md:grid-cols-12">
      <div class="reveal md:col-span-6">
        <p class="mono text-muted">$ ls ~/tools</p>
        <ul class="mt-4 flex flex-wrap gap-2">
          {tools.map((t) => <li class="tag">{t}</li>)}
        </ul>
      </div>
      <div class="reveal md:col-span-6">
        <p class="mono text-muted">$ cat learning.log</p>
        <ul class="mt-4 space-y-2">
          {
            learning.map((l) => (
              <li class="flex gap-3 text-ink/80">
                <span class="font-mono text-accent">→</span>
                {l}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
