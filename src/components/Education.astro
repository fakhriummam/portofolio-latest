---
import SectionHeading from './SectionHeading.astro';
import { education } from '../data/profile';
---

<section id="education" class="section">
  <div class="container-x">
    <SectionHeading index="07" label="Education" title="Learning, in and out of class." />
    <ul class="divide-y divide-line border-y border-line">
      {
        education.map((e) => (
          <li class="reveal grid gap-2 py-8 md:grid-cols-12 md:gap-8">
            <p class="text-sm text-muted md:col-span-3">{e.period}</p>
            <div class="md:col-span-9">
              <h3 class="display text-2xl">{e.school}</h3>
              <p class="mt-1 text-ink/75">{e.detail}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
