---
import { values } from '../data/profile';
---

<section id="values" class="section bg-ink text-paper">
  <div class="container-x">
    <header class="reveal mb-14 grid gap-4 md:grid-cols-12">
      <p class="text-xs font-medium uppercase tracking-[0.18em] text-paper/50 md:col-span-3 md:pt-3">
        <span class="text-[#8fc2bc]">05</span><span class="mx-2 text-paper/20">—</span>Character
      </p>
      <div class="md:col-span-9">
        <h2 class="display text-3xl leading-[1.1] sm:text-4xl md:text-5xl">
          Shaped by pesantren.
        </h2>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-paper/70">{values.intro}</p>
      </div>
    </header>

    <ol class="grid gap-px overflow-hidden border border-paper/10 bg-paper/10 sm:grid-cols-2 lg:grid-cols-3">
      {
        values.items.map((v, i) => (
          <li class="reveal bg-ink p-7 sm:p-8">
            <span class="display text-sm text-[#8fc2bc]">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="display mt-3 text-xl">{v.title}</h3>
            <p class="mt-3 leading-relaxed text-paper/65">{v.text}</p>
          </li>
        ))
      }
      <li class="reveal hidden items-end bg-ink p-7 sm:flex sm:p-8 lg:flex">
        <p class="display text-2xl italic leading-snug text-paper/40">Attitude first. Skills follow.</p>
      </li>
    </ol>
  </div>
</section>
