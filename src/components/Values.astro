---
import { values } from '../data/profile';
---

<section id="values" class="section bg-term text-paper">
  <div class="container-x">
    <header class="reveal mb-14 grid gap-4 md:grid-cols-12">
      <p class="mono text-paper/50 md:col-span-3 md:pt-3">
        <span class="text-term-green">05</span><span class="mx-1.5 opacity-40">/</span>~/character
      </p>
      <div class="md:col-span-9">
        <h2 class="display text-3xl leading-[1.1] sm:text-4xl md:text-[2.75rem]">
          Shaped by pesantren.
        </h2>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-paper/70">{values.intro}</p>
      </div>
    </header>

    <ol class="grid gap-px overflow-hidden rounded-lg border border-term-line bg-term-line sm:grid-cols-2 lg:grid-cols-3">
      {
        values.items.map((v, i) => (
          <li class="reveal bg-term p-7 sm:p-8">
            <span class="font-mono text-[0.75rem] text-term-green">[{String(i + 1).padStart(2, '0')}]</span>
            <h3 class="display mt-3 text-lg">{v.title}</h3>
            <p class="mt-3 leading-relaxed text-paper/65">{v.text}</p>
          </li>
        ))
      }
      <li class="reveal hidden items-end bg-term p-7 sm:flex sm:p-8 lg:flex">
        <p class="font-mono text-[0.95rem] leading-relaxed text-paper/50"><span class="text-term-green">$</span> echo "Attitude first. Skills follow."<span class="cursor text-term-green/80" aria-hidden="true"></span></p>
      </li>
    </ol>
  </div>
</section>
