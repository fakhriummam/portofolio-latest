---
import SectionHeading from './SectionHeading.astro';
import { gallery } from '../data/profile';

// Only show photos that exist, so there are never "coming soon" or empty tiles.
// Tiles are portrait (3:4) to suit phone photos and use the full content width,
// like the Selected work cards. The column count follows the number of photos
// so rows stay full: 1–2 photos are centred, 3 → 3 columns, 4+ → 4 or 3 columns,
// whichever divides the count evenly.
const photos = gallery.filter((g) => g.src);
const n = photos.length;

let layout: string;
if (n === 1) layout = 'mx-auto max-w-xs grid-cols-1';
else if (n === 2) layout = 'mx-auto max-w-2xl grid-cols-2';
else if (n === 3) layout = 'grid-cols-3';
else if (n % 4 === 0 || n % 3 !== 0) layout = 'grid-cols-2 md:grid-cols-4';
else layout = 'grid-cols-2 md:grid-cols-3';
---

{
  n > 0 && (
    <section id="gallery" class="section">
      <div class="container-x">
        <SectionHeading index="06" label="Documentation" title="On the job." />

        <ul class:list={['grid gap-3 sm:gap-5', layout]}>
          {photos.map((g) => (
            <li class="reveal">
              <figure class="group">
                <a href={g.src} target="_blank" rel="noopener" class="block overflow-hidden rounded-sm bg-paper-2">
                  <img
                    src={g.src}
                    alt={g.caption}
                    loading="lazy"
                    class="aspect-[3/4] w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
                  />
                </a>
                <figcaption class="mt-2 font-mono text-[0.75rem] leading-snug text-muted">{g.caption}</figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
