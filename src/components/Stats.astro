---
import { stats } from '../data/profile';
---

<section aria-label="At a glance" class="border-y border-line bg-paper-2/60">
  <dl class="container-x grid grid-cols-2 md:grid-cols-4">
    {
      stats.map((s, i) => (
        <div
          class:list={[
            'reveal flex flex-col py-8 sm:py-10',
            i % 2 === 1 && 'border-l border-line pl-5 sm:pl-8',
            i >= 2 && 'border-t border-line md:border-t-0',
            i > 0 && 'md:border-l md:pl-8',
          ]}
        >
          <dt class="order-2 mt-2 font-mono text-[0.75rem] leading-snug text-muted">{s.label}</dt>
          <dd class="font-mono text-[1.7rem] font-medium tracking-tight text-ink sm:text-[2.1rem]">{s.value}</dd>
        </div>
      ))
    }
  </dl>
</section>
