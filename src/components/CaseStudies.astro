---
import SectionHeading from './SectionHeading.astro';
import { caseStudies } from '../data/profile';
import sharp from 'sharp';
import path from 'node:path';

// Read each screenshot/photo's real size at build time so the frame fits it:
// phone photos (portrait) get 3:4 tiles, screenshots (landscape) get wide tiles.
// This also works for images uploaded later through the admin panel.
const isPortrait = async (src: string) => {
  try {
    const m = await sharp(path.join(process.cwd(), 'public', src)).metadata();
    return (m.height ?? 0) > (m.width ?? 0);
  } catch {
    return false;
  }
};
const projects = await Promise.all(
  caseStudies.map(async (c) => {
    const flags = await Promise.all(c.images.map((img) => isPortrait(img.src)));
    return { ...c, portrait: flags.length > 0 && flags.every(Boolean) };
  }),
);
const num = (i: number) => String(i + 1).padStart(2, '0');
---

<section id="work" class="section bg-paper-2/50">
  <div class="container-x">
    <SectionHeading index="03" label="Selected work" title="Real problems, practical fixes." />

    <!--
      Short list: one line per project. Clicking a row opens an overlay with
      the full story (Problem / What I did / Result), photos and the link.
    -->
    <ul class="divide-y divide-line border-y border-line">
      {
        projects.map((c, i) => (
          <li class="reveal">
            <button
              type="button"
              data-open={`project-${c.slug}`}
              aria-haspopup="dialog"
              class="group flex w-full items-center gap-4 py-5 text-left transition-colors hover:bg-paper/70 sm:gap-6 sm:px-3 sm:py-6"
            >
              <span class="block h-14 w-[4.5rem] shrink-0 overflow-hidden rounded-sm border border-line bg-paper-2 sm:h-[4.5rem] sm:w-24">
                {c.images[0] ? (
                  <img
                    src={c.images[0].src}
                    alt=""
                    loading="lazy"
                    class="h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-105"
                  />
                ) : (
                  <span class="display flex h-full w-full items-center justify-center text-xl text-accent/70">
                    {num(i)}
                  </span>
                )}
              </span>

              <span class="min-w-0 flex-1">
                <span class="flex items-baseline gap-3">
                  <span class="display text-sm text-accent">{num(i)}</span>
                  <span class="truncate text-[0.7rem] uppercase tracking-[0.16em] text-muted">{c.context}</span>
                </span>
                <span class="display mt-1 block text-xl leading-snug sm:text-2xl">{c.title}</span>
                <span class="mt-1 block text-sm leading-relaxed text-ink/70 sm:text-[0.95rem]">{c.summary}</span>
              </span>

              <span class="hidden shrink-0 items-center gap-2 text-sm text-accent md:flex">
                Details
                <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
              </span>
              <span aria-hidden="true" class="shrink-0 text-accent transition-transform group-hover:translate-x-1 md:hidden">
                →
              </span>
            </button>
          </li>
        ))
      }
    </ul>
  </div>

  {
    projects.map((c, i) => (
      <dialog
        id={`project-${c.slug}`}
        aria-labelledby={`project-${c.slug}-title`}
        class="project-dialog w-[calc(100%-1.5rem)] max-w-3xl max-h-[92vh] overflow-y-auto rounded-sm shadow-2xl"
      >
        <div class="p-6 sm:p-10">
          <div class="flex items-start justify-between gap-6">
            <div>
              <p class="flex items-baseline gap-3 text-xs uppercase tracking-[0.16em] text-muted">
                <span class="display text-sm normal-case tracking-normal text-accent">{num(i)}</span>
                {c.context}
              </p>
              <h3 id={`project-${c.slug}-title`} class="display mt-3 text-2xl leading-tight sm:text-3xl">
                {c.title}
              </h3>
            </div>
            <form method="dialog" class="dialog-close shrink-0">
              <button
                class="flex h-9 w-9 items-center justify-center rounded-full border border-line text-lg text-ink/70 transition-colors hover:border-ink hover:text-ink"
                aria-label="Close"
              >
                ×
              </button>
            </form>
          </div>

          {c.images.length > 0 && (
            <div
              class:list={[
                'mt-7 grid gap-3',
                c.portrait
                  ? c.images.length === 2
                    ? 'grid-cols-2'
                    : c.images.length >= 3
                      ? 'grid-cols-3'
                      : 'max-w-xs'
                  : [c.images.length === 2 && 'sm:grid-cols-2', c.images.length >= 3 && 'sm:grid-cols-3'],
              ]}
            >
              {c.images.map((img) => (
                <figure>
                  <a href={img.src} target="_blank" rel="noopener" class="block overflow-hidden rounded-sm border border-line">
                    <img
                      src={img.src}
                      alt={img.caption}
                      loading="lazy"
                      class:list={[
                        'w-full object-cover object-top',
                        c.portrait ? 'aspect-[3/4]' : c.images.length > 1 && 'aspect-[16/10]',
                      ]}
                    />
                  </a>
                  <figcaption class="mt-2 text-xs leading-snug text-muted">{img.caption}</figcaption>
                </figure>
              ))}
            </div>
          )}

          <dl class="mt-8 space-y-5 text-[0.95rem] leading-relaxed">
            <div>
              <dt class="text-xs font-medium uppercase tracking-wider text-muted">Problem</dt>
              <dd class="mt-1 text-ink/80">{c.problem}</dd>
            </div>
            <div>
              <dt class="text-xs font-medium uppercase tracking-wider text-muted">What I did</dt>
              <dd class="mt-1 text-ink/80">{c.action}</dd>
            </div>
            <div class="border-l-2 border-accent pl-4">
              <dt class="text-xs font-medium uppercase tracking-wider text-accent">Result</dt>
              <dd class="mt-1 text-ink">{c.result}</dd>
            </div>
          </dl>

          <div class="mt-8 flex flex-wrap items-center justify-between gap-4 border-t border-line pt-6">
            <ul class="flex flex-wrap gap-2">
              {c.tags.map((t) => (
                <li class="tag text-xs">{t}</li>
              ))}
            </ul>
            {c.link && (
              <a href={c.link} target="_blank" rel="noopener" class="link-u text-sm text-accent">
                Visit {c.link.replace(/^https?:\/\//, '')} <span aria-hidden="true">↗</span>
              </a>
            )}
          </div>
        </div>
      </dialog>
    ))
  }
</section>

<script>
  // Open the matching overlay when a project row is clicked.
  document.querySelectorAll<HTMLButtonElement>('[data-open]').forEach((btn) => {
    const dialog = document.getElementById(btn.dataset.open!) as HTMLDialogElement | null;
    if (!dialog) return;
    btn.addEventListener('click', () => dialog.showModal());
    // Clicking the dark area around the box closes it (Esc and × already do).
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    // Return focus to the row that opened it.
    dialog.addEventListener('close', () => btn.focus({ preventScroll: true }));
  });
</script>
