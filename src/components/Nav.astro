---
import { profile } from '../data/profile';

const links = [
  { href: '#about', label: 'About' },
  { href: '#experience', label: 'Experience' },
  { href: '#work', label: 'Work' },
  { href: '#skills', label: 'Skills' },
  { href: '#contact', label: 'Contact' },
];
---

<header
  id="site-nav"
  class="fixed inset-x-0 top-0 z-40 border-b border-transparent transition-colors duration-300"
>
  <nav class="container-x flex h-16 items-center justify-between" aria-label="Main">
    <a href="#top" class="display text-lg">
      {profile.shortName}<span class="text-accent">.</span>
    </a>

    <ul class="hidden items-center gap-8 text-sm text-muted md:flex">
      {
        links.map((l) => (
          <li>
            <a href={l.href} class="transition-colors hover:text-ink">
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <button
      id="nav-toggle"
      class="-mr-2 p-2 md:hidden"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="block h-px w-6 bg-ink transition-transform" data-bar="1"></span>
      <span class="mt-2 block h-px w-6 bg-ink transition-transform" data-bar="2"></span>
    </button>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-line bg-paper md:hidden">
    <ul class="container-x flex flex-col py-4">
      {
        links.map((l) => (
          <li>
            <a href={l.href} class="display block py-3 text-2xl" data-close>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  const nav = document.getElementById('site-nav')!;
  const toggle = document.getElementById('nav-toggle')!;
  const menu = document.getElementById('mobile-menu')!;

  const onScroll = () => {
    const scrolled = window.scrollY > 8;
    nav.classList.toggle('bg-paper/85', scrolled);
    nav.classList.toggle('backdrop-blur', scrolled);
    nav.classList.toggle('border-line', scrolled);
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const setOpen = (open: boolean) => {
    menu.classList.toggle('hidden', !open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    const [a, b] = toggle.querySelectorAll<HTMLElement>('[data-bar]');
    a.style.transform = open ? 'translateY(4.5px) rotate(45deg)' : '';
    b.style.transform = open ? 'translateY(-4.5px) rotate(-45deg)' : '';
    if (open) nav.classList.add('bg-paper');
    else nav.classList.remove('bg-paper');
  };
  toggle.addEventListener('click', () => setOpen(menu.classList.contains('hidden')));
  menu.querySelectorAll('[data-close]').forEach((a) => a.addEventListener('click', () => setOpen(false)));
</script>
